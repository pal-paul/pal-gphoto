GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_ACCOUNT_EMAIL=<google-account-email>
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/google/callback
PAL_GPHOTO_TOKEN_KEY=<base64-encoded-32-byte-key>
PAL_GPHOTO_LISTEN_ADDR=:8080
PAL_GPHOTO_DATA_DIR=/data
PAL_GPHOTO_MEDIA_DIR=/data/media
PAL_GPHOTO_DATABASE_PATH=/data/pal-gphoto.db
PAL_GPHOTO_POLL_INTERVAL=30s
